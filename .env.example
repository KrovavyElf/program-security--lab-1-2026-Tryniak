# Скопіюйте цей файл у .env (у тій самій папці, поруч з docker-compose.yml) і заповніть
# реальними значеннями. .env НЕ комітиться в git (див. .gitignore) — саме тому appsettings.json
# у репозиторії не містить робочих секретів: без .env docker-compose свідомо відмовиться
# стартувати замість того, щоб тихо піднятись із публічно відомою заглушкою (див. аудит безпеки,
# розділ README "Усунення несправностей").

# --- PostgreSQL ---
# Згенеруйте, наприклад: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- JWT ---
# Мінімум 32 випадкових символи. Згенеруйте: openssl rand -base64 48
JWT_SECRET=

# --- Платіжний шлюз (Webhook) ---
# Захищає СПРАВЖНІЙ ендпоінт /api/payments/webhook від підроблених запитів.
# Для реального LiqPay/Stripe тут буде секрет, виданий шлюзом; для поточної mock-реалізації —
# будь-який випадковий рядок. Згенеруйте: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

# --- SMTP (опційно) ---
# Якщо не заповнити — листи не надсилатимуться реально, лише логуватимуться.
# Найшвидший спосіб отримати реально робочі дані — Gmail App Password (5 хв, без затвердження):
#   1. Увімкніть двофакторну автентифікацію на аккаунті Google (google.com/account/security).
#   2. Створіть пароль застосунку: myaccount.google.com/apppasswords -> "Пошта" -> Створити.
#   3. Скопійований 16-символьний пароль (без пробілів) — це SMTP_PASSWORD нижче,
#      SMTP_USERNAME і SMTP_FROM_EMAIL — ваша повна адреса @gmail.com.
# Для іншого поштового провайдера просто підставте його SMTP-хост/порт замість Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Публічна адреса фронтенду ---
# Використовується для CORS та для формування посилань у листах/mock-оплаті.
FRONTEND_BASE_URL=http://localhost
